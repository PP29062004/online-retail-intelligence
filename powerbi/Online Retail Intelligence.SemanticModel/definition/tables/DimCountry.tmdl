table DimCountry

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	partition DimCountry = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(pDataFolder & "\DimCountry.csv"), [Delimiter=",", Columns=1, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Country", type text}}, "en-GB")
				in
				    Typed
